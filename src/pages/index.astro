---
import Base from '../layouts/Base.astro';
import AdoptionLadder from '../components/AdoptionLadder.astro';
import BatchLifecycle from '../components/BatchLifecycle.astro';
import DistributionLineage from '../components/DistributionLineage.astro';
import EvidenceProof from '../components/EvidenceProof.astro';
import Topology from '../components/Topology.astro';
import VerificationSpectrum from '../components/VerificationSpectrum.astro';

// The plain-language trust model. Each row maps one of the five to a capability
// that exists in the pack today — no forward-looking claims in this list.
// `backticks` in the third field render as inline mono, mini-markdown style.
const trust = [
  [
    'Context',
    'Give the agent your repo’s declared commands and policy.',
    'adopting repos declare their base branch, setup, and validation commands in a small ' +
      '`.agents/` directory, and shared skills read them — so a portable workflow runs your ' +
      'commands instead of inventing them.',
  ],
  [
    'Scope',
    'Risky or delegated work gets an explicit list of the files it owns.',
    '`pr-batch` requires an execution envelope of owned paths when lane risk or bounded ' +
      'delegation calls for one. Widening it is allowed where a path is genuinely necessary — ' +
      'but every added path has to be recorded, with its reason, in the lane record the ' +
      'coordinator reads.',
  ],
  [
    'Validation',
    'Require current-commit validation before accepting “done”.',
    '`.agents/bin/validate` is the pre-push gate, and review reads check status at the pull ' +
      'request’s current head SHA — not an older, greener run.',
  ],
  [
    'Evidence',
    'Require commands and results behind verification claims.',
    'lanes attach a QA evidence block to the PR — exact commands, exact results — and treat ' +
      'CI logs as evidence rather than decoration. “The agent said it tested” is not proof.',
  ],
  [
    'Review',
    'Use independent review and explicit merge authority.',
    'an independent checker QAs the maker’s work, `adversarial-pr-review` red-teams the diff ' +
      'for what is wrong rather than summarizing it, and unresolved review threads are ' +
      'triaged before work is called merge-ready. Merge authority follows your repo policy.',
  ],
];

// Selected skills from the pack; the upstream catalog is the current inventory.
// "day one" marks the set documented as working with no coordination backend
// and no repo seam.
const skills = [
  ['day one', 'verify', 'Run your repo’s real setup and validation, then prove the branch is ready before you open the PR.'],
  ['day one', 'tdd', 'Red-green-refactor discipline — reproduce the bug as a failing test first, then fix it.'],
  ['day one', 'adversarial-pr-review', 'Red-team a change before merge — correctness, security, scope, and merge-readiness, not a summary.'],
  ['day one', 'address-review', 'Triage PR review comments into must-fix, discuss, optional, and skipped — then work the list.'],
  ['day one', 'update-changelog', 'An honest changelog built from what actually merged.'],
  ['at scale', 'plan-pr-batch', 'Shape candidate issues and PRs into a ready batch plan and a pasteable goal prompt — before any worker starts.'],
  ['at scale', 'triage', 'Build a whole-surface issue/PR inventory, a dependency graph, and a capacity-aware split across agents and machines.'],
  ['at scale', 'pr-batch', 'Run one coordinated PR lane or a multi-lane batch across worktrees and machines, safely and in dependency order.'],
  ['at scale', 'batch-status', 'Ask where every lane stands right now — coordination state reconciled against live GitHub.'],
  ['at scale', 'post-merge-audit', 'Audit merged batch work for missed reviews, changelog gaps, cross-PR interactions, and release risk.'],
];

const stages = [
  ['plan-pr-batch', 'Turn issues into a scoped, dependency-aware batch and a goal prompt.'],
  ['triage', 'Map the whole surface; split work to fit your agent and machine capacity.'],
  ['pr-batch', 'Run the workers — one lane, or many, coordinated through the backend.'],
  ['adversarial-pr-review', 'Skeptical pre-merge review that hunts for what is wrong.'],
  ['post-merge-audit', 'Sweep the merged batch for gaps and cross-PR surprises.'],
];

const safety = [
  ['Security preflight', 'The workflow requires treating public GitHub text as data until its author, scope, and trust boundary are verified. The scanner flags known risks; a clean result does not establish trust.'],
  ['The Rule of Two', 'The security policy prohibits combining untrusted input, sensitive access, and unattended state change or disclosure. Configure host permissions and credentials to enforce that boundary.'],
  ['Operator hard-stops', 'The workflow requires explicit authority for consequential actions such as deploys, secret handling, and token provisioning. Missing authority calls for an operator handoff.'],
  ['Trust-gated actors', 'Trust configuration identifies actors whose input may be actionable. Actor findings are advisory by default; strict-trust makes them launch blockers. An exact-target risk acknowledgement does not grant blanket trust.'],
];

const gh = 'https://github.com/shakacode';

const pageTitle = 'Agent Workflows — the engineering system around your coding agents';
const pageDescription =
  'Open-source workflows that make context, scope, validation, evidence, and human review ' +
  'explicit for AI coding agents — on your next pull request, and across coordinated fleets. ' +
  'Plus practical adoption help from ShakaCode.';
---
<Base title={pageTitle} description={pageDescription}>
  <!-- HERO -->
  <section class="hero" style="border-top:none">
    <div class="wrap">
      <div class="stagger hero-copy">
        <span class="eyebrow">Open source · Codex + Claude Code</span>
        <h1>The engineering system around your <em>coding agents</em>.</h1>
        <p class="lead">Your agent writes the code. This is everything around it — the context it
          starts from, the scope it may touch, the checks it must pass, the evidence it leaves,
          and the human review that lands it. Choose the safeguards your app needs, from a shared
          tool to a critical service.</p>
        <div class="cta">
          <a class="btn btn-primary" href={`${gh}/agent-workflows`}>Get started ↗</a>
          <a class="btn btn-ghost" href="/methodology/">Read the methodology →</a>
        </div>
      </div>
      <div class="panel hero-panel">
        <BatchLifecycle />
        <p class="diagram-caption">How the work moves — the security preflight checks public input for known risks. Agents still need permission boundaries and must follow the workflow for one lane or many.</p>
      </div>
    </div>
  </section>

  <!-- VERIFICATION SPECTRUM -->
  <section id="verification">
    <div class="wrap section-head">
      <span class="eyebrow">Start with the consequences</span>
      <h2>What happens if this breaks?</h2>
      <p>For a disposable personal app, describe what you want, try it, and keep chatting.
        You don’t need to learn a set of skills first. As people depend on the result,
        add checks that protect their time, data, and trust.</p>
    </div>
    <div class="wrap">
      <VerificationSpectrum />
      <div class="verification-decision">
        <h3>Make the next check earn its cost.</h3>
        <p>Count development time, verification effort, expected failure cost, and delayed delivery.
          A check earns its place when it reduces a meaningful risk. Once the required checks pass,
          another round of optional polish can cost more than it helps.</p>
        <a class="btn btn-ghost" href="/methodology/#balance-verification-with-delivery">Choose proportionate verification →</a>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section id="problem">
    <div class="wrap section-head">
      <span class="eyebrow">01 / the problem</span>
      <h2>The hard part isn’t the code. It’s knowing what was checked.</h2>
      <p>Once others depend on your app, even one agent on one pull request has this problem. It hands you something plausible,
        and you are left reconstructing what it read, what it was allowed to change, what it
        actually ran, and what any of that proves. Agent Workflows makes those answers explicit
        from your first PR — one agent, one repo, nothing to host. Use those same questions when you scale to many agents across many repositories.</p>
    </div>
  </section>

  <!-- THE MODEL -->
  <section id="model">
    <div class="wrap section-head">
      <span class="eyebrow">02 / the model</span>
      <h2>Five things an agent should never leave implicit.</h2>
      <p>Trust in agent work isn’t a feeling — it’s five questions with checkable answers. Every
        part of this project exists to make one of them explicit, and each one already works on a
        single pull request.</p>
    </div>
    <div class="wrap">
      <ul class="rule-list model-list">
        {trust.map(([term, promise, today]) => (
          <li>
            <span class="n">{term}</span>
            <span>
              <strong>{promise}</strong>
              <span class="model-today">
                <span class="lbl mono">today</span>
                {today.split('`').map((part, i) => (i % 2 ? <code class="mono">{part}</code> : part))}
              </span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how">
    <div class="wrap section-head">
      <span class="eyebrow">03 / how it works</span>
      <h2>Install the process once. Each repo answers for itself.</h2>
      <p>Two words carry the mechanism. The shared <em>pack</em> holds the process — the skills,
        the prompts, the gates. Each adopting repo keeps its real commands in a small
        <code class="mono">.agents/</code> <em>seam</em> — the directory from the model above — so
        shared workflows resolve every repo’s base branch, validation, CI triggers, and review
        gates without copying, and then drifting, a full config tree into every checkout. The pack supports Codex and Claude Code from shared skill sources, with
        host-specific installation and invocation guidance.</p>
      <p>Small seam files give humans and agents a familiar place to look across repositories:
        <code class="mono">AGENTS.md</code> points to each repo’s commands and policies.
        The organization stays consistent; the rules stay local. A prototype and a production
        service can share that structure while requiring different checks.
        <a href="/methodology/#seam-files-preserve-attention-across-repositories">How seam files preserve attention →</a></p>
      <p>Astra users can use the same workflow pack, with an advisory routing pilot and guidance
        for carrying authorized work through verification. <a href="/docs/astra/">Astra and model routing →</a></p>
    </div>
    <div class="wrap">
      <ol class="rule-list">
        {stages.map(([name, desc], i) => (
          <li>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span><strong class="mono">{name}</strong> — <span>{desc}</span></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills">
    <div class="wrap section-head">
      <span class="eyebrow">04 / what you get</span>
      <h2>A skill for every step of the loop.</h2>
      <p>Portable skills and workflow prompts for Codex and Claude Code. Browse the{' '}
        <a href={`${gh}/agent-workflows#skill-inventory`}>current skill catalog</a>. The
        ones marked <strong>day one</strong> work the moment you install them — no coordination
        backend, no repo seam. Ten of them:</p>
    </div>
    <div class="wrap">
      <div class="grid skills-grid">
        {skills.map(([tier, name, desc]) => (
          <div class="card">
            <div class="card-top">
              <h3 class="k">{name}</h3>
              <span class={tier === 'day one' ? 'tier tier-now' : 'tier'}>{tier}</span>
            </div>
            <p>{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ADOPTION LADDER -->
  <section id="adopt">
    <div class="wrap section-head">
      <span class="eyebrow">05 / adoption</span>
      <h2>Adopt only as much machinery as the work requires.</h2>
      <p>Choose how much of the pack to adopt for your work.
        Three levels, each solving a real problem on its own, each optional until you actually hit
        it.</p>
    </div>
    <div class="wrap">
      <AdoptionLadder />
    </div>
  </section>

  <!-- EVIDENCE -->
  <section id="evidence">
    <div class="wrap section-head">
      <span class="eyebrow">06 / evidence from real use</span>
      <h2>What actually went wrong, and what changed because of it.</h2>
      <p>Claims are cheap; incident records are not. Every number in the card below is traceable to
        a published case study or to a public issue or pull request you can open right now. One
        study, shown in full — including the control that still isn’t finished.</p>
    </div>
    <div class="wrap">
      <EvidenceProof />
    </div>
  </section>

  <!-- SAFETY -->
  <section id="safety">
    <div class="wrap section-head">
      <span class="gatebadge">security preflight</span>
      <span class="eyebrow" style="margin-top:6px">07 / the safety story</span>
      <h2>Bound the risk from public input.</h2>
      <p>The workflow calls for keeping untrusted input, sensitive access, and unattended
        state change from meeting in one session. Enforcing that policy requires
        configured host permissions; the scanner alone is not a security boundary.{' '}
        <a href={`${gh}/agent-workflows/blob/main/docs/security-posture.md`}>Read the security policy and preflight limits →</a></p>
    </div>
    <div class="wrap">
      <ul class="rule-list">
        {safety.map(([title, desc], i) => (
          <li>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span><strong>{title}</strong> — <span>{desc}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- THE STACK -->
  <section id="stack">
    <div class="wrap section-head">
      <span class="eyebrow">08 / the stack</span>
      <h2>The pack, the backend, and the dashboard.</h2>
      <p>Three focused pieces. The pack is the public process layer; the coordination backend is the
        protocol plane; the dashboard is a separate operator view that reads the same state.</p>
    </div>
    <div class="wrap">
      <div class="panel">
        <Topology />
      </div>
      <div class="grid stack-grid" style="margin-top:22px">
        <a class="card" href={`${gh}/agent-workflows`}>
          <h3 class="k">agent-workflows ↗</h3>
          <p>The portable Codex/Claude workflow pack — skills, workflow prompts, and the repo seam contract. MIT.</p>
        </a>
        <a class="card" href={`${gh}/agent-coordination`}>
          <h3 class="k">agent-coordination ↗</h3>
          <p>Mutual-exclusion claims, TTL heartbeats (live/stale/dead), and batch lanes — over a Cloudflare Worker + D1, or a zero-config local mode. The scripted contention test checks that competing workers on one target produce one winner and one branch. Claims depend on workers using the same backend and target identity.</p>
        </a>
        <a class="card" href={`${gh}/agent-coordination-dashboard`}>
          <h3 class="k">dashboard ↗</h3>
          <p>A local operator console: a dense, searchable table of every lane and PR — state, liveness, and “wedged” detection — live over the coordination API. Read-only, loopback by default.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- DISTRIBUTIONS -->
  <section id="distributions">
    <div class="wrap distribution-layout">
      <div class="distribution-copy">
        <span class="eyebrow">09 / Git-native customization</span>
        <h2>Customize freely. Keep the divergence visible.</h2>
        <blockquote>“AI reduces the cost of divergence without hiding divergence.”</blockquote>
        <p class="lead">Agent Workflows is designed for both a trusted upstream and a healthy
          ecosystem of customized distributions. A Consumer Repo owns its policy through the Agent
          Workflow Configuration Seam. A maintained fork becomes a Derived Distribution with an
          exact upstream baseline, explicit patches, independent validation, and its own release
          claims.</p>
        <a class="btn btn-ghost" href="/docs/distributions/">Explore the distribution model →</a>
      </div>
      <div class="panel distribution-panel">
        <DistributionLineage />
        <p class="distribution-status"><strong>Today:</strong> development-channel installation.{' '}
          <strong>Target:</strong> immutable human-reviewed Upstream Releases and formal Derived
          Distribution tooling.</p>
      </div>
    </div>
  </section>

  <!-- METHODOLOGY -->
  <section id="methodology">
    <div class="wrap methodology">
      <span class="eyebrow">10 / methodology</span>
      <blockquote>“Use AI aggressively, verify the risky parts, document what was learned, and keep shipping.”</blockquote>
      <p class="lead">The playbook is that method, compiled: adversarial review before merge, CI logs
        as evidence rather than decoration, manual QA where behavior can change, and review findings judged by real impact
        before they become more work.</p>
      <a class="btn btn-ghost" href="/methodology/">Read the methodology →</a>
    </div>
  </section>

  <!-- FOR TEAMS -->
  <section id="for-teams">
    <div class="wrap consulting">
      <div class="consulting-copy">
        <span class="eyebrow">11 / for engineering teams</span>
        <h2>Bring the operating model into your organization.</h2>
        <p class="lead">The open-source pack is the starting point. ShakaCode helps engineering
          teams turn ad-hoc AI coding into a repeatable system: choose the right tools, encode
          reusable skills, establish trust and verification gates, and run multiple agent tasks
          asynchronously without losing control of quality.</p>
        <div class="cta">
          <a class="btn btn-primary" href="https://www.shakacode.com/contact/">Talk with ShakaCode ↗</a>
          <a class="btn btn-ghost" href="https://www.shakacode.com/services/">Explore our services ↗</a>
        </div>
      </div>
      <div class="panel proof-panel" aria-label="ShakaCode experience">
        <div class="proof">
          <strong>Since 2011</strong>
          <span>Remote-first software consulting and delivery</span>
        </div>
        <div class="proof">
          <strong>23M+</strong>
          <span>Open-source package downloads</span>
        </div>
        <div class="proof">
          <strong>Practical adoption</strong>
          <span>Assessment, rollout, guardrails, and team enablement</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .verification-decision { display: grid; gap: 14px; margin-top: 30px; padding-top: 24px; border-top: 1px solid var(--line-strong); max-width: 75ch; }
  .verification-decision p { color: var(--ink-dim); }
  .verification-decision .btn { justify-self: start; }

  .hero { padding-top: clamp(56px, 8vw, 96px); }
  .hero .wrap { display: grid; gap: clamp(34px, 5vw, 56px); }
  .hero-copy { display: grid; gap: 22px; max-width: 34ch; }
  /* the headline is a full sentence, not three words: step the display size
     down from the global h1 token so the CTAs stay above the fold. */
  .hero-copy h1 { font-size: clamp(2.35rem, 4.7vw, 3.5rem); text-wrap: balance; }
  .hero-copy h1 em { font-style: italic; color: var(--brand-ink); }
  .hero-copy .lead { max-width: 52ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
  .hero-panel { padding: clamp(18px, 3vw, 34px); }

  /* On a phone the hero has to fit both CTAs above the fold — tighten the
     leading, the gaps and the top padding rather than cutting the message. */
  @media (max-width: 560px) {
    .hero { padding-top: 34px; }
    .hero-copy { gap: 16px; }
    .hero-copy h1 { font-size: clamp(2.05rem, 8.4vw, 2.45rem); }
    .hero-copy .lead { font-size: 1.04rem; line-height: 1.5; }
  }

  @media (min-width: 940px) {
    .hero .wrap { grid-template-columns: 0.92fr 1.08fr; align-items: center; }
    .hero-copy { max-width: none; }
  }

  /* the five-part trust model — a rule-list whose rail holds a word, not a number */
  .model-list li { grid-template-columns: 1fr; gap: 10px; padding: 22px 0; }
  .model-list .n {
    color: var(--brand-ink); font-size: 0.74rem;
    letter-spacing: 0.22em; text-transform: uppercase;
  }
  .model-list strong { display: block; color: var(--ink); font-weight: 600; font-size: 1.08rem; line-height: 1.4; }
  .model-list .model-today { display: block; color: var(--ink-dim); font-size: 0.98rem; margin-top: 7px; }
  .model-list .lbl {
    /* --ink-dim, not --ink-faint: at 0.7rem this needs 4.5:1 in both themes. */
    color: var(--ink-dim); font-size: 0.7rem; letter-spacing: 0.2em;
    text-transform: uppercase; margin-right: 0.9em;
  }

  @media (min-width: 760px) {
    .model-list li { grid-template-columns: 9.5em 1fr; gap: 22px; }
  }

  .skills-grid { grid-template-columns: repeat(auto-fit, minmax(248px, 1fr)); }
  .skills-grid .card { display: grid; gap: 10px; align-content: start; }
  .card-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  /* The tier pill never wraps, so the name's min-content used to set the whole
     card row and push it past a narrow viewport at a large browser font. Letting
     the name shrink and break fixes that without flex-wrap, which would have
     re-laid-out the desktop cards: at a 16px root no card row is over-constrained,
     so this rule changes nothing there. */
  .card-top > * { min-width: 0; overflow-wrap: anywhere; }
  .tier {
    flex: none; font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.16em;
    /* the tier carries meaning, so it has to clear 4.5:1 like any other label */
    text-transform: uppercase; color: var(--ink-dim); border: 1px solid var(--line);
    border-radius: 999px; padding: 0.3em 0.75em; white-space: nowrap;
  }
  .tier-now { color: var(--brand-ink); border-color: color-mix(in srgb, var(--brand) 42%, transparent); }

  .stack-grid { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  a.card { transition: border-color .2s, transform .16s; }
  a.card:hover { border-color: color-mix(in srgb, var(--brand) 50%, transparent); transform: translateY(-3px); }
  @media (prefers-reduced-motion: reduce) {
    a.card, a.card:hover { transform: none; transition: none; }
  }

  #safety .gatebadge { justify-self: start; }

  .distribution-layout { display: grid; gap: clamp(30px, 5vw, 58px); align-items: center; }
  .distribution-copy { display: grid; gap: 20px; }
  .distribution-copy blockquote {
    margin: 0; color: var(--ink); font-family: var(--font-display); font-size: clamp(1.55rem, 3vw, 2.25rem);
    font-weight: 430; line-height: 1.2; letter-spacing: -0.01em;
  }
  .distribution-copy .btn { justify-self: start; }
  .distribution-panel { display: grid; gap: 22px; }
  .distribution-status { padding-top: 18px; border-top: 1px solid var(--line); color: var(--ink-dim); font-size: 0.9rem; }
  .distribution-status strong { color: var(--ink); font-weight: 600; }

  @media (min-width: 940px) {
    .distribution-layout { grid-template-columns: 0.88fr 1.12fr; }
  }

  .methodology { max-width: 64ch; display: grid; gap: 22px; }
  .methodology blockquote {
    margin: 0; font-family: var(--font-display); font-weight: 420;
    font-size: clamp(1.7rem, 3.6vw, 2.7rem); line-height: 1.18; letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .methodology .btn { justify-self: start; }

  .consulting { display: grid; gap: clamp(30px, 5vw, 58px); align-items: center; }
  .consulting-copy { display: grid; gap: 20px; }
  .consulting-copy .lead { max-width: 60ch; }
  .proof-panel { display: grid; gap: 0; padding-block: 8px; }
  .proof { display: grid; gap: 2px; padding: 20px 8px; border-top: 1px solid var(--line); }
  .proof:first-child { border-top: 0; }
  .proof strong { color: var(--brand-ink); font-family: var(--font-mono); font-size: 1rem; }
  .proof span { color: var(--ink-dim); font-size: 0.95rem; }

  @media (min-width: 840px) {
    .consulting { grid-template-columns: 1.25fr 0.75fr; }
  }

  code.mono { font-size: 0.86em; padding: 0.1em 0.4em; border: 1px solid var(--line); border-radius: 6px; background: color-mix(in srgb, var(--surface) 70%, transparent); }
</style>
