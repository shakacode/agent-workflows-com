---
import Base from '../layouts/Base.astro';
import BatchLifecycle from '../components/BatchLifecycle.astro';
import Topology from '../components/Topology.astro';

const skills = [
  ['plan-pr-batch', 'Shape candidate issues and PRs into a ready batch plan and a pasteable goal prompt — before any worker starts.'],
  ['triage', 'Build a whole-surface issue/PR inventory, a dependency graph, and a capacity-aware split across agents and machines.'],
  ['pr-batch', 'Launch and coordinate multi-PR agent work across worktrees or machines, safely and in dependency order.'],
  ['adversarial-pr-review', 'Red-team a change before merge — correctness, security, scope, and merge-readiness, not a summary.'],
  ['post-merge-audit', 'Audit merged batch work for missed reviews, changelog gaps, cross-PR interactions, and release risk.'],
  ['replicate-ci', 'Reproduce a CI-only failure locally when the hosted run is red but your machine is green.'],
  ['verify / verify-pr-fix', 'Run a local verification loop and prove a bug is actually gone — reproduce before, confirm after.'],
  ['update-changelog', 'Classify merged PRs and stamp changelog entries so releases never ship undocumented.'],
];

const stages = [
  ['plan-pr-batch', 'Turn issues into a scoped, dependency-aware batch and a goal prompt.'],
  ['triage', 'Map the whole surface; split work to fit your agent and machine capacity.'],
  ['pr-batch', 'Run the workers — one lane per target, coordinated through the backend.'],
  ['adversarial-pr-review', 'Skeptical pre-merge review that hunts for what is wrong.'],
  ['post-merge-audit', 'Sweep the merged batch for gaps and cross-PR surprises.'],
];

const safety = [
  ['Security preflight', 'Untrusted GitHub text — issues, PRs, comments, review bodies — is treated as data, never as instructions. A public issue cannot quietly steer your agent.'],
  ['Operator hard-stops', 'Risky steps — deploys, secret handling, token provisioning, machine flips — stop and hand off to you instead of improvising.'],
  ['Trust-gated actors', 'Only allowlisted humans and bots can act as review input or steer a batch; everyone else is metadata-only, queued for triage.'],
  ['Declared scope boundaries', 'Forbidden scope is stated up front, so an eager model cannot “helpfully” start next phase’s work in this one.'],
];

const gh = 'https://github.com/shakacode';
---
<Base>
  <!-- HERO -->
  <section class="hero" style="border-top:none">
    <div class="wrap">
      <div class="stagger hero-copy">
        <span class="eyebrow">Open source · Codex + Claude Code</span>
        <h1>Run AI coding agents<br />in fleets — <em>safely</em>.</h1>
        <p class="lead">The ShakaCode Agent Workflow Playbook is a portable pack for planning,
          batching, reviewing, and auditing multi-PR agent work across all your repos.
          Install the process once; each repo exposes a tiny seam.</p>
        <div class="cta">
          <a class="btn btn-primary" href={`${gh}/agent-workflows`}>Get started ↗</a>
          <a class="btn btn-ghost" href="#methodology">Read the methodology →</a>
        </div>
      </div>
      <div class="panel hero-panel">
        <BatchLifecycle />
        <p class="diagram-caption">The batch lifecycle — the amber gate is the differentiator: untrusted input is checked before an agent ever acts on it.</p>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section id="problem">
    <div class="wrap section-head">
      <span class="eyebrow">01 / the problem</span>
      <h2>One agent, one PR doesn’t scale.</h2>
      <p>A single agent on a single PR is easy. Running many agents across many repositories is
        where it breaks — trust boundaries, CI parity, review load, scope creep, merge safety.
        The playbook turns that into a repeatable, gated process instead of a pile of prompts.</p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how">
    <div class="wrap section-head">
      <span class="eyebrow">02 / how it works</span>
      <h2>Install the process once. Expose a tiny seam per repo.</h2>
      <p>The shared pack carries the <em>process</em>. Each adopting repo keeps its real commands
        in a small <code class="mono">.agents/</code> seam, so shared workflows resolve every repo’s
        base branch, validation, CI triggers, and review gates without copying — and drifting — a
        full config tree into every checkout.</p>
    </div>
    <div class="wrap">
      <ol class="rule-list">
        {stages.map(([name, desc], i) => (
          <li>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span><strong class="mono">{name}</strong> — <span>{desc}</span></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills">
    <div class="wrap section-head">
      <span class="eyebrow">03 / what you get</span>
      <h2>A skill for every step of the loop.</h2>
      <p>Portable skills and workflow prompts for Codex and Claude Code — install them under your
        skill root and each repo’s seam does the rest.</p>
    </div>
    <div class="wrap">
      <div class="grid skills-grid">
        {skills.map(([name, desc]) => (
          <div class="card">
            <span class="k">{name}</span>
            <p>{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SAFETY -->
  <section id="safety">
    <div class="wrap section-head">
      <span class="gatebadge">security preflight</span>
      <span class="eyebrow" style="margin-top:6px">04 / the safety story</span>
      <h2>Agents a public issue can’t hijack.</h2>
      <p>The real differentiator isn’t speed — it’s that untrusted input, secret access, and
        state-change never meet in one unattended session.</p>
    </div>
    <div class="wrap">
      <ul class="rule-list">
        {safety.map(([title, desc], i) => (
          <li>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span><strong>{title}</strong> — <span>{desc}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- THE STACK -->
  <section id="stack">
    <div class="wrap section-head">
      <span class="eyebrow">05 / the stack</span>
      <h2>The pack, the backend, and the dashboard.</h2>
      <p>Three focused pieces. The pack is the public process layer; the coordination backend is the
        protocol plane; the dashboard is a separate operator view that reads through a published contract.</p>
    </div>
    <div class="wrap">
      <div class="panel">
        <Topology />
      </div>
      <div class="grid stack-grid" style="margin-top:22px">
        <a class="card" href={`${gh}/agent-workflows`}>
          <span class="k">agent-workflows ↗</span>
          <p>The portable Codex/Claude workflow pack — skills, workflow prompts, and the repo seam contract.</p>
        </a>
        <a class="card" href={`${gh}/agent-coordination`}>
          <span class="k">agent-coordination ↗</span>
          <p>The coordination backend: claims, heartbeats, liveness, and batch lifecycle over a Worker + D1 API.</p>
        </a>
        <a class="card" href={`${gh}/agent-coordination-dashboard`}>
          <span class="k">dashboard ↗</span>
          <p>A local operator view — what’s running, what’s stuck, who owns which PR across your fleet.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- METHODOLOGY -->
  <section id="methodology">
    <div class="wrap methodology">
      <span class="eyebrow">06 / methodology</span>
      <blockquote>“Use AI aggressively, verify the risky parts, document what was learned, and keep shipping.”</blockquote>
      <p class="lead">The playbook is that method, compiled: adversarial review before merge, CI logs
        as evidence rather than decoration, manual QA where behavior can change, and every vague
        blocker turned into a specific issue or a docs PR.</p>
      <a class="btn btn-ghost" href={`${gh}/agent-workflows#readme`}>Read the write-up →</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: clamp(56px, 8vw, 96px); }
  .hero .wrap { display: grid; gap: clamp(34px, 5vw, 56px); }
  .hero-copy { display: grid; gap: 22px; max-width: 34ch; }
  .hero-copy h1 em { font-style: italic; color: var(--brand-ink); }
  .hero-copy .lead { max-width: 52ch; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
  .hero-panel { padding: clamp(18px, 3vw, 34px); }

  @media (min-width: 940px) {
    .hero .wrap { grid-template-columns: 0.92fr 1.08fr; align-items: center; }
    .hero-copy { max-width: none; }
  }

  .skills-grid { grid-template-columns: repeat(auto-fit, minmax(248px, 1fr)); }
  .stack-grid { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  a.card { transition: border-color .2s, transform .16s; }
  a.card:hover { border-color: color-mix(in srgb, var(--brand) 50%, transparent); transform: translateY(-3px); }

  #safety .gatebadge { justify-self: start; }

  .methodology { max-width: 64ch; display: grid; gap: 22px; }
  .methodology blockquote {
    margin: 0; font-family: var(--font-display); font-weight: 420;
    font-size: clamp(1.7rem, 3.6vw, 2.7rem); line-height: 1.18; letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .methodology .btn { justify-self: start; }
  code.mono { font-size: 0.86em; padding: 0.1em 0.4em; border: 1px solid var(--line); border-radius: 6px; background: color-mix(in srgb, var(--surface) 70%, transparent); }
</style>
