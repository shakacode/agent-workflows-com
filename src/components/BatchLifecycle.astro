---
// The batch lifecycle: untrusted GitHub work passes a security-preflight gate
// (amber), flows through five stages, all backed by the coordination backend.
---
<figure class="lifecycle">
  <svg viewBox="0 0 960 300" role="img" width="100%" aria-labelledby="lc-t lc-d">
    <title id="lc-t">The agent batch lifecycle</title>
    <desc id="lc-d">GitHub issues and PRs pass a security preflight gate, then flow through plan, triage, pr-batch, review, and audit, all backed by a coordination backend tracking claims, heartbeats, and liveness.</desc>
    <defs>
      <marker id="lc-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M2 1L8 5L2 9" fill="none" stroke="var(--ink-faint)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>

    <text class="lc-eyebrow" x="40" y="92">from github issues &amp; prs</text>

    <!-- security preflight gate -->
    <g>
      <rect x="40" y="112" width="164" height="66" rx="12" fill="color-mix(in srgb, var(--gate) 13%, transparent)" stroke="var(--gate)" stroke-width="1.4" />
      <text class="lc-node" x="122" y="139" text-anchor="middle" fill="var(--gate-ink)">security preflight</text>
      <text class="lc-sub" x="122" y="160" text-anchor="middle">untrusted text ≠ instructions</text>
    </g>
    <line x1="204" y1="145" x2="248" y2="145" stroke="var(--ink-faint)" stroke-width="1.6" marker-end="url(#lc-arrow)" />

    <!-- pipeline stages -->
    <g class="stages">
      <g><rect x="250" y="119" width="116" height="52" rx="26" /><text x="308" y="150" text-anchor="middle">plan</text></g>
      <g><rect x="386" y="119" width="116" height="52" rx="26" /><text x="444" y="150" text-anchor="middle">triage</text></g>
      <g><rect x="522" y="119" width="116" height="52" rx="26" /><text x="580" y="150" text-anchor="middle">pr-batch</text></g>
      <g><rect x="658" y="119" width="116" height="52" rx="26" /><text x="716" y="150" text-anchor="middle">review</text></g>
      <g><rect x="794" y="119" width="116" height="52" rx="26" /><text x="852" y="150" text-anchor="middle">audit</text></g>
    </g>
    <g stroke="var(--ink-faint)" stroke-width="1.6">
      <line x1="366" y1="145" x2="386" y2="145" marker-end="url(#lc-arrow)" />
      <line x1="502" y1="145" x2="522" y2="145" marker-end="url(#lc-arrow)" />
      <line x1="638" y1="145" x2="658" y2="145" marker-end="url(#lc-arrow)" />
      <line x1="774" y1="145" x2="794" y2="145" marker-end="url(#lc-arrow)" />
    </g>

    <!-- dashed leaders to the backend rail -->
    <g stroke="var(--gate)" stroke-width="1.3" stroke-dasharray="3 4" opacity="0.7">
      <line x1="580" y1="171" x2="580" y2="228" />
      <line x1="716" y1="171" x2="716" y2="228" />
      <line x1="852" y1="171" x2="852" y2="228" />
    </g>

    <!-- coordination backend rail -->
    <rect x="250" y="230" width="660" height="46" rx="12" fill="var(--bg-elev)" stroke="var(--line-strong)" stroke-width="1.2" />
    <text class="lc-rail" x="580" y="258" text-anchor="middle">coordination backend · claims · heartbeats · liveness</text>
  </svg>
</figure>

<style>
  .lifecycle { margin: 0; }
  .lifecycle svg { display: block; }
  .lc-eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; fill: var(--ink-faint); }
  .lc-node { font-family: var(--font-body); font-size: 15px; font-weight: 500; }
  .lc-sub { font-family: var(--font-mono); font-size: 10.5px; fill: var(--ink-faint); }
  .lc-rail { font-family: var(--font-mono); font-size: 13px; fill: var(--ink-dim); }
  .stages rect { fill: var(--surface); stroke: color-mix(in srgb, var(--brand) 42%, transparent); stroke-width: 1.3; }
  .stages text { font-family: var(--font-body); font-size: 15px; font-weight: 500; fill: var(--ink); }
</style>
