---
// How the pieces fit: hosts run the pack; the pack installs once and exposes a
// seam per repo; consumer repos drive the coordination backend; the dashboard
// stays a SEPARATE repo that reads through a published state-schema contract.
//
// Plain HTML + CSS, not a fixed-viewBox SVG — same reason as BatchLifecycle.
// A `viewBox="0 0 960 …"` scaled to fit renders its own type at ~7px on a
// tablet and ~3px on a phone. Real text keeps a real font size at every width.
---
<figure class="topo">
  <div
    class="tp-flow"
    role="img"
    aria-label="How the pieces fit together: Codex and Claude Code run the agent-workflows pack, installed once with a seam per repo. Consumer repos drive the agent-coordination backend. The dashboard is a separate repo that reads coordination state over a published contract."
  >
    <section class="tp-stage">
      <p class="tp-kind">hosts</p>
      <ul class="tp-chips">
        <li>Codex</li>
        <li>Claude Code</li>
      </ul>
      <p class="tp-note">run the pack</p>
    </section>

    <span class="tp-arrow" aria-hidden="true"><span class="tp-arrow-glyph">&#8594;</span></span>

    <section class="tp-stage tp-stage-brand">
      <p class="tp-kind tp-kind-brand">the pack</p>
      <p class="tp-name">agent-workflows</p>
      <p class="tp-note">installed once — one <code>.agents/</code> seam per repo</p>
      <p class="tp-seam">
        <span class="tp-seam-mark" aria-hidden="true">&#8627;</span>
        your repos — the seam contract
      </p>
    </section>

    <span class="tp-arrow" aria-hidden="true">
      <span class="tp-arrow-glyph">&#8594;</span>
      <span class="tp-arrow-label">agent-coord</span>
    </span>

    <section class="tp-stage">
      <p class="tp-kind">mit protocol plane</p>
      <p class="tp-name">agent-coordination</p>
      <ul class="tp-pills">
        <li>agent-coord CLI</li>
        <li>Worker + D1</li>
      </ul>
      <p class="tp-note">claims &#183; heartbeats &#183; liveness</p>
      <p class="tp-store">state — private</p>
    </section>

    <!-- The dashboard is deliberately a separate row: it is a separate repo
         that only reads, over a published contract. Amber marks that seam. It
         shares the flow's grid so the dashed leader drops out of the
         coordination column exactly, not merely close to it. -->
    <p class="tp-consumer-link">reads coordination state &#183; HTTP API</p>
    <div class="tp-consumer-box">
      <p class="tp-kind tp-kind-gate">separate repo</p>
      <p class="tp-name">agent-coordination-dashboard</p>
      <p class="tp-note">operator view</p>
    </div>
  </div>
</figure>

<style>
  .topo { margin: 0; }

  .tp-flow {
    display: grid;
    grid-template-columns: 1fr auto 1.1fr auto 1.15fr;
    gap: 0 12px;
    align-items: stretch;
  }

  .tp-stage {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 18px;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--surface);
  }
  .tp-stage-brand {
    border-color: color-mix(in srgb, var(--brand) 55%, transparent);
    background: color-mix(in srgb, var(--brand) 7%, var(--surface));
  }

  /* --ink-dim, not --ink-faint: these labels carry meaning, so they have to
     clear 4.5:1 on both themes at this size. */
  .tp-kind {
    margin: 0;
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .tp-kind-brand { color: var(--brand-ink); }
  .tp-kind-gate { color: var(--gate-ink); }

  .tp-name {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.35;
    overflow-wrap: break-word;
  }

  .tp-note {
    margin: 0;
    color: var(--ink-dim);
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .tp-note code {
    font-family: var(--font-mono);
    font-size: 0.92em;
  }

  .tp-chips, .tp-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 2px 0 1px;
    padding: 0;
    list-style: none;
  }
  .tp-chips li, .tp-pills li {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.3;
    padding: 0.34em 0.8em;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--bg-elev);
  }
  .tp-pills li { border-color: color-mix(in srgb, var(--brand) 40%, transparent); }

  /* the seam: a dashed hand-off from the pack down into the adopting repo */
  .tp-seam {
    display: flex;
    gap: 0.5em;
    margin: 5px 0 0;
    padding-top: 10px;
    border-top: 1px dashed color-mix(in srgb, var(--brand) 45%, transparent);
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.45;
  }
  .tp-seam-mark { flex: none; color: var(--brand-ink); }

  .tp-store {
    margin: 5px 0 0;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .tp-arrow {
    display: grid;
    gap: 3px;
    justify-items: center;
    align-content: center;
    color: var(--ink-dim);
    font-family: var(--font-mono);
  }
  .tp-arrow-glyph { font-size: 1.15rem; line-height: 1; }
  .tp-arrow-label { font-size: 0.78rem; line-height: 1.3; white-space: nowrap; }

  .tp-consumer-link {
    grid-column: 5;
    margin: 0;
    padding: 10px 0 12px 16px;
    border-left: 1px dashed color-mix(in srgb, var(--gate) 60%, transparent);
    color: var(--gate-ink);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.4;
  }
  .tp-consumer-box {
    grid-column: 1 / -1;
    display: grid;
    gap: 6px;
    padding: 16px 18px;
    border: 1px solid color-mix(in srgb, var(--gate) 55%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--gate) 9%, var(--surface));
  }

  /* Below ~900px the three-across flow stops fitting at a legible size, so the
     arrows turn down and the stages stack. Only the glyph rotates — a rotated
     text label would be unreadable. Expressed in em so a large browser default
     font stacks the row instead of overflowing it. */
  @media (max-width: 56.25em) {
    .tp-flow { grid-template-columns: 1fr; gap: 0; }
    .tp-stage, .tp-consumer-box { margin-bottom: 12px; }
    .tp-arrow { grid-auto-flow: column; gap: 0.6em; margin-bottom: 12px; }
    .tp-arrow-glyph { transform: rotate(90deg); }
    .tp-consumer-link { grid-column: 1; margin-left: 20px; padding-top: 0; }
    .tp-consumer-box { margin-bottom: 0; }
  }
</style>
