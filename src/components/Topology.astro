---
// How the pieces fit: hosts run the pack; the pack installs once and exposes a
// seam per repo; consumer repos drive the coordination backend; the dashboard
// stays a SEPARATE repo that reads through a published state-schema contract.
---
<figure class="topo">
  <svg viewBox="0 0 960 360" role="img" width="100%" aria-labelledby="tp-t tp-d">
    <title id="tp-t">How the pieces fit together</title>
    <desc id="tp-d">Codex and Claude Code run the agent-workflows pack, installed once with a seam per repo. Consumer repos drive the agent-coordination backend. The dashboard is a separate repo that reads coordination state over a published contract.</desc>
    <defs>
      <marker id="tp-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M2 1L8 5L2 9" fill="none" stroke="var(--ink-faint)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </marker>
    </defs>

    <!-- hosts -->
    <g class="chip"><rect x="34" y="60" width="150" height="42" rx="10" /><text x="109" y="86" text-anchor="middle">Codex</text></g>
    <g class="chip"><rect x="34" y="114" width="150" height="42" rx="10" /><text x="109" y="140" text-anchor="middle">Claude Code</text></g>
    <line x1="184" y1="108" x2="242" y2="108" stroke="var(--ink-faint)" stroke-width="1.6" marker-end="url(#tp-arrow)" />

    <!-- the pack -->
    <g class="box brand">
      <rect x="244" y="56" width="222" height="104" rx="14" />
      <text class="ttl" x="262" y="90">agent-workflows</text>
      <text class="sub" x="262" y="114">the portable pack — installed</text>
      <text class="sub" x="262" y="132">once, one .agents/ seam per repo</text>
    </g>
    <!-- seam to repos -->
    <line x1="355" y1="160" x2="355" y2="196" stroke="var(--brand)" stroke-width="1.4" stroke-dasharray="3 4" marker-end="url(#tp-arrow)" />
    <g class="chip"><rect x="244" y="198" width="222" height="44" rx="10" /><text x="355" y="225" text-anchor="middle">your repos — the seam contract</text></g>

    <!-- pack -> coordination -->
    <line x1="466" y1="108" x2="536" y2="108" stroke="var(--ink-faint)" stroke-width="1.6" marker-end="url(#tp-arrow)" />
    <text class="edge" x="501" y="98" text-anchor="middle">agent-coord</text>

    <!-- coordination / protocol plane -->
    <g class="box">
      <rect x="538" y="46" width="270" height="150" rx="14" />
      <text class="ttl" x="558" y="80">agent-coordination</text>
      <text class="tag" x="558" y="100">MIT protocol plane</text>
      <g class="pill"><rect x="558" y="112" width="110" height="34" rx="17" /><text x="613" y="134" text-anchor="middle">agent-coord CLI</text></g>
      <g class="pill"><rect x="676" y="112" width="112" height="34" rx="17" /><text x="732" y="134" text-anchor="middle">Worker + D1</text></g>
      <text class="sub" x="558" y="176">claims · heartbeats · liveness</text>
    </g>

    <!-- private state -->
    <g class="cyl">
      <ellipse cx="878" cy="78" rx="42" ry="12" />
      <path d="M836 78 v48 a42 12 0 0 0 84 0 v-48" />
      <text x="878" y="112" text-anchor="middle">state</text>
      <text class="sub" x="878" y="150" text-anchor="middle">private</text>
    </g>
    <line x1="808" y1="120" x2="836" y2="108" stroke="var(--ink-faint)" stroke-width="1.6" marker-end="url(#tp-arrow)" />

    <!-- dashboard: separate consumer via contract -->
    <g class="box amber">
      <rect x="538" y="256" width="270" height="72" rx="14" />
      <text class="ttl" x="558" y="288">agent-coordination-dashboard</text>
      <text class="sub" x="558" y="310">operator view — separate repo</text>
    </g>
    <line x1="673" y1="256" x2="673" y2="196" stroke="var(--gate)" stroke-width="1.5" stroke-dasharray="4 4" marker-end="url(#tp-arrow)" />
    <text class="edge amberedge" x="688" y="228" text-anchor="start">published state-schema contract (HTTP)</text>
  </svg>
</figure>

<style>
  .topo { margin: 0; }
  .topo svg { display: block; }
  .topo text { font-family: var(--font-body); fill: var(--ink); }
  .chip rect { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.2; }
  .chip text { font-size: 14px; font-weight: 500; }
  .box rect { fill: var(--bg-elev); stroke: var(--line-strong); stroke-width: 1.3; }
  .box.brand rect { stroke: color-mix(in srgb, var(--brand) 55%, transparent); }
  .box.amber rect { stroke: color-mix(in srgb, var(--gate) 55%, transparent); fill: color-mix(in srgb, var(--gate) 8%, var(--bg-elev)); }
  .box .ttl { font-family: var(--font-mono); font-size: 14.5px; font-weight: 500; }
  .box .sub, .cyl .sub { font-family: var(--font-mono); font-size: 11px; fill: var(--ink-faint); }
  .box .tag { font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; fill: var(--brand-ink); }
  .pill rect { fill: var(--surface); stroke: color-mix(in srgb, var(--brand) 40%, transparent); stroke-width: 1.1; }
  .pill text { font-family: var(--font-mono); font-size: 11.5px; fill: var(--ink); }
  .edge { font-family: var(--font-mono); font-size: 11px; fill: var(--ink-faint); }
  .amberedge { fill: var(--gate-ink); }
  .cyl ellipse, .cyl path { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.3; }
  .cyl text { font-family: var(--font-mono); font-size: 13px; }
</style>
