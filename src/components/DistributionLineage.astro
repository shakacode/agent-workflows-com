<style>
  .lineage { margin: 0; }
  .lineage-flow { display: grid; grid-template-columns: 1fr auto 1.2fr auto 1fr; gap: 14px; align-items: stretch; }
  .lineage-node {
    /* min-width:0 — a grid item defaults to min-width:auto, which pins the
