       user font sizes. */
    display: grid; gap: 5px; align-content: center; min-height: 104px; padding: 18px; min-width: 0;
    background: var(--surface); border: 1px solid var(--line-strong); border-radius: 12px;
  }
  .lineage-node.derived {
    border-color: color-mix(in srgb, var(--brand) 55%, transparent);
    background: color-mix(in srgb, var(--brand) 7%, var(--surface));
  }
  /* 0.8rem, not 0.72rem: below ~12px this uppercase mono label stops being
     comfortably readable — the same floor the other two diagrams hold to. */
  .kind { color: var(--brand-ink); font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; }
  strong { color: var(--ink); font-family: var(--font-body); font-size: 0.95rem; font-weight: 500; line-height: 1.35; }
  /* --ink-dim, not --ink-faint: at --ink-faint the connector sits at 3.7:1,
