  .arrow { align-self: center; color: var(--ink-dim); font-family: var(--font-mono); font-size: 1.25rem; }
  figcaption { margin-top: 14px; color: var(--ink-dim); font-family: var(--font-mono); font-size: 0.76rem; }

  /* em, not px: this breakpoint has to fire on the user's font size too, not
